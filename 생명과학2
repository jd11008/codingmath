            color: var(--link-color);
            border-color: rgba(56, 139, 253, 0.4);
            animation: pulseState 2s infinite;
        }

        @keyframes pulseState {
            0% { opacity: 0.8; }
            50% { opacity: 1; }
            100% { opacity: 0.8; }
        }

