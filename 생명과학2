    <style>
        /* ==========================================================================
           1. CORE GLOBAL STYLES & VARIABLE RECONSTRUCTION
           ========================================================================== */
        :root {
            --bg-main: #0b0e14;
            --bg-panel: #161b22;
            --bg-terminal: #090d13;
            --bg-card: #21262d;
            --bg-card-hover: #30363d;
            --border-main: #30363d;
            --border-active: #58a6ff;
            --border-danger: #f85149;
            --text-main: #c9d1d9;
            --text-bright: #f0f6fc;
            --text-muted: #8b949e;
            --link-color: #58a6ff;
            --syntax-green: #7ee787;
            --syntax-orange: #ffa657;
            --syntax-purple: #d2a8ff;
            --syntax-red: #ff7b72;
            --shadow-depth: 0 8px 24px rgba(0,0,0,0.4);
            --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            padding: 30px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* ==========================================================================
           2. HEADER & BRANDING COMPONENT LAYER
           ========================================================================== */
        header {
            max-width: 1650px;
            width: 100%;
            margin: 0 auto 25px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--border-main);
            padding-bottom: 20px;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-brand h1 {
            font-size: 30px;
            color: var(--text-bright);
            font-weight: 800;
            letter-spacing: -0.8px;
            background: linear-gradient(90deg, #f0f6fc, #58a6ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .tag-container {
            display: flex;
            gap: 8px;
            align-items: center;
        }

