            border: 1px solid var(--border-main);
            border-radius: 14px;
            padding: 22px;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-depth);
            height: calc(100vh - 140px);
            min-height: 750px;
            overflow: hidden;
