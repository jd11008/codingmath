            border: 1px solid var(--border-main);
            color: var(--text-normal);
            font-size: 11px;
            font-weight: 600;
            padding: 8px;
            border-radius: 6px;
            cursor: pointer;
            text-align: left;
            transition: var(--transition-smooth);
        }

        .recipe-btn:hover {
            background: var(--bg-card-hover);
            border-color: var(--text-muted);
            color: var(--text-bright);
        }

        .gene-node-card {
            background: var(--bg-terminal);
            border: 1px solid var(--border-main);
            border-radius: 8px;
            padding: 12px 14px;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .gene-node-card:hover {
            border-color: var(--border-active);
            background: #19202c;
            transform: translateX(3px);
        }

        .gene-meta-data {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .gene-title-text {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-bright);
        }

        .gene-explain-text {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.3;
        }

        .codon-badge-render {
            font-family: "Courier New", monospace;
            font-size: 11px;
            font-weight: 700;
            background: var(--bg-card);
            padding: 4px 8px;
            border-radius: 4px;
            color: var(--syntax-green);
            border: 1px solid var(--border-main);
        }

        /* ==========================================================================
           5. CENTER PANEL: LABORATORY MATRIX & GRAPHICS COMPONENT
           ========================================================================== */
        .center-matrix {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .linear-sequence-deck {
            background: var(--bg-terminal);
            border: 1px solid var(--border-main);
            border-radius: 10px;
            padding: 16px;
        }

        .deck-header-info {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

