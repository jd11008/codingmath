           3. MASTER DASHBOARD LAYOUT FRAMEWORK
           ========================================================================== */
        .master-dashboard {
            display: grid;
            grid-template-columns: 380px 1fr 420px;
            gap: 25px;
            max-width: 1650px;
            width: 100%;
            margin: 0 auto;
            flex: 1;
        }

